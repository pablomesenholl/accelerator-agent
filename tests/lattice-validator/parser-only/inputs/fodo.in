TITLE, STRING="250 MeV proton FODO, no space charge";
OPTION, VERSION=10900;
OPTION, SEED=123456789;
OPTION, PSDUMPFREQ=100, STATDUMPFREQ=1, ENABLEHDF5=TRUE;
// T is kinetic energy in GeV; PMASS is the built-in proton rest mass.
REAL kinetic=0.250;
REAL P0=sqrt(kinetic*(kinetic+2*PMASS));
REAL lquad=0.5;
REAL ldrift=0.5;
REAL strength=1.5;
QF: QUADRUPOLE, L=lquad, ELEMEDGE=0, K1=strength;
D1: DRIFT, L=ldrift, ELEMEDGE=lquad;
QD: QUADRUPOLE, L=lquad, ELEMEDGE=lquad+ldrift, K1=-strength;
D2: DRIFT, L=ldrift, ELEMEDGE=2*lquad+ldrift;
Cell: LINE=(QF,D1,QD,D2);
Initial: DISTRIBUTION, TYPE=MULTIVARIATEGAUSS, NPARTDIST=10000,
 SIGMAX=1e-3, SIGMAY=1e-3, SIGMAZ=5e-3,
 SIGMAPX=3.48922e-4, SIGMAPY=4.23738e-4, SIGMAPZ=1e-5,
 CORR={0.829278,0,0,0,0,0,0,0,0,-0.734451,0,0,0,0,0};
Source: EMISSIONSOURCE, DISTRIBUTION=Initial;
Sources: EMISSIONSOURCELIST=(Source);
Protons: BEAM, PARTICLE=PROTON, PC=P0, NALLOC=10000,
 BCHARGE=1e-9, CHARGE=1, SOURCES=Sources;
NoSC: FIELDSOLVER, TYPE=NONE, NX=8, NY=8, NZ=8,
 PARFFTX=TRUE, PARFFTY=TRUE, PARFFTZ=TRUE,
 BCFFTX=OPEN, BCFFTY=OPEN, BCFFTZ=OPEN;
TRACK, LINE=Cell, BEAM=Protons, ZSTART=0,
 DT={1e-11}, MAXSTEPS={2000}, ZSTOP={2.0};
 RUN, METHOD=PARALLEL, FIELDSOLVER=NoSC;
ENDTRACK;
QUIT;
